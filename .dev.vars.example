# 本地开发环境变量示例
# 复制此文件为 .dev.vars 并填入实际值

# JWT 签名密钥（必需）
# 生成方法: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# 数据加密密钥（必需）
# 生成方法: openssl rand -base64 32
ENCRYPTION_KEY=your_encryption_key_here

# OAuth 配置（可选）
# OAUTH_CLIENT_ID=your_oauth_client_id
# OAUTH_CLIENT_SECRET=your_oauth_client_secret
